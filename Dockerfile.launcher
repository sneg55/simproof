FROM node:26.7.0-bookworm-slim@sha256:cd565714d4da3e84bfd341e31448f81d47c6362198f152345297c9c1154e6341 AS build

WORKDIR /source
RUN npm install --global pnpm@11.13.1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.production.json ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter @simproof/runner...
RUN pnpm exec tsc --build apps/runner/tsconfig.production.json --pretty false
RUN pnpm --filter @simproof/runner deploy --legacy --prod /runtime \
    && find /runtime -type f \( -name '*.ts' -o -name '*.ts.map' -o -name '*.test.js' \) -delete

FROM docker:27.5.1-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c AS docker-cli

FROM node:26.7.0-bookworm-slim@sha256:cd565714d4da3e84bfd341e31448f81d47c6362198f152345297c9c1154e6341

ENV NODE_ENV=production
WORKDIR /app
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=build --chown=65532:65532 /runtime /app
USER 65532:65532
EXPOSE 4318
CMD ["node", "/app/dist/launcher-start.js"]
