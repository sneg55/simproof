FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS build

WORKDIR /source
RUN npm install --global pnpm@11.13.1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.production.json ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter @simproof/runner...
RUN pnpm exec tsc --build apps/runner/tsconfig.production.json --pretty false
RUN pnpm --filter @simproof/runner deploy --legacy --prod /runtime \
    && find /runtime -type f \( -name '*.ts' -o -name '*.ts.map' -o -name '*.test.js' \) -delete

FROM docker:29.6.2-cli@sha256:be132a9f282288de4afaf63379dff75711fda0147c6b72a9df44e51841402144 AS docker-cli

FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d

ENV NODE_ENV=production
WORKDIR /app
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=build --chown=65532:65532 /runtime /app
USER 65532:65532
EXPOSE 4318
CMD ["node", "/app/dist/launcher-start.js"]
