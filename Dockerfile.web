FROM node:26.7.0-bookworm-slim@sha256:cd565714d4da3e84bfd341e31448f81d47c6362198f152345297c9c1154e6341 AS build

WORKDIR /source
RUN npm install --global pnpm@11.13.1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter @simproof/web...
RUN pnpm exec tsc --build packages/contracts/tsconfig.production.json --pretty false
RUN pnpm --filter @simproof/web build

FROM node:26.7.0-bookworm-slim@sha256:cd565714d4da3e84bfd341e31448f81d47c6362198f152345297c9c1154e6341

ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=65532:65532 /source/apps/web/dist /app/public
COPY --chown=65532:65532 deployment/web-server.mjs /app/deployment/web-server.mjs
USER 65532:65532
EXPOSE 8080
CMD ["node", "/app/deployment/web-server.mjs"]
