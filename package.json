{
  "name": "simproof",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.13.1"
  },
  "scripts": {
    "audit:dependencies": "pnpm audit --audit-level high",
    "format": "biome check --write .",
    "format:check": "biome ci .",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint": "pnpm lint:biome && pnpm lint:eslint",
    "check:ui": "node scripts/check-ui-boundary.mjs && eslint \"apps/web/src/**/*.{jsx,tsx}\" --max-warnings 0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --build tsconfig.json --pretty false",
    "check:file-size": "node scripts/check-file-size.mjs",
    "generate:domain-pack-fingerprints": "node scripts/generate-domain-pack-fingerprints.mjs",
    "check:domain-pack-fingerprints": "node scripts/generate-domain-pack-fingerprints.mjs --check",
    "check:ci-workflow": "node --test scripts/check-ci-workflow.test.mjs && node scripts/check-ci-workflow.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:test-network": "node scripts/check-test-network-policy.mjs",
    "check:test-gates": "node scripts/run-test-gate.mjs integration --validate && node scripts/run-test-gate.mjs security --validate && node scripts/run-test-gate.mjs diagnostics --validate && node scripts/run-test-gate.mjs deployment --validate",
    "db:migrate": "pnpm --filter @simproof/persistence db:migrate",
    "build": "node scripts/build-production.mjs",
    "proof": "python3 proof/simproof_proof.py",
    "check": "pnpm check:domain-pack-fingerprints && pnpm format:check && pnpm lint && pnpm check:ui && pnpm check:ci-workflow && pnpm check:secrets && pnpm check:test-network && pnpm check:test-gates && pnpm typecheck && pnpm check:file-size && pnpm test && pnpm proof && pnpm build",
    "test": "node scripts/run-tests.mjs",
    "test:repository": "node scripts/run-tests.mjs --filter repository",
    "test:domain-packs": "node scripts/run-tests.mjs --filter domain-pack-conformance",
    "test:integration": "node scripts/run-test-gate.mjs integration",
    "test:security": "node scripts/run-test-gate.mjs security",
    "test:diagnostics": "node scripts/run-test-gate.mjs diagnostics",
    "test:deployment": "node scripts/run-test-gate.mjs deployment",
    "diagnostics": "node apps/orchestrator/dist/operations/diagnostics-cli.js",
    "test:e2e": "node scripts/run-web-browser-gate.mjs e2e",
    "test:a11y": "node scripts/run-web-browser-gate.mjs a11y",
    "release:dry-run": "node scripts/generate-release-evidence.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@simproof/contracts": "workspace:*",
    "@types/node": "26.6.4",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
